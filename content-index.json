---
layout: null
permalink: /content-index.json
sitemap: false
search: false
---
{
  "version": 1,
  "site": {{ site.title | jsonify }},
  "url": {{ '/' | absolute_url | jsonify }},
  "items": [
  {% assign entries = site.pages | concat: site.projects | concat: site.publications | concat: site.posts %}
  {% assign first_item = true %}
  {% for entry in entries %}{% if entry.title and entry.layout and entry.search != false %}
    {% unless first_item %},{% endunless %}{% assign first_item = false %}
    {
      "title": {{ entry.title | jsonify }},
      "url": {{ entry.url | absolute_url | jsonify }},
      "type": {% if entry.collection == 'projects' %}"Project"{% elsif entry.collection == 'publications' %}"Publication"{% elsif entry.collection == 'posts' %}"Research note"{% else %}"Page"{% endif %},
      "description": {{ entry.description | default: entry.intro | default: entry.summary | default: entry.abstract | default: entry.excerpt | default: site.description | strip_html | normalize_whitespace | truncate: 350 | jsonify }},
      "topics": {{ entry.topics | default: entry.keywords | default: site.keywords | jsonify }},
      "text": {% if entry.collection %}{{ entry.content | strip_html | normalize_whitespace | jsonify }}{% else %}{{ entry.description | default: entry.intro | default: site.description | jsonify }}{% endif %}
      {% if entry.status or entry.type %}, "status": {{ entry.status | default: entry.type | jsonify }}{% endif %}
    }
  {% endif %}{% endfor %}
  ]
}
