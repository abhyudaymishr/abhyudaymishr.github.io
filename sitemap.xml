---
layout: null
permalink: /sitemap.xml
sitemap: false
search: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign entries = site.pages | concat: site.posts | concat: site.projects | concat: site.publications %}
  {% for item in entries %}{% if item.title and item.layout and item.sitemap != false and item.noindex != true %}
  <url><loc>{{ item.url | replace: 'index.html', '' | absolute_url | xml_escape }}</loc>{% if item.last_modified_at %}<lastmod>{{ item.last_modified_at | date_to_xmlschema }}</lastmod>{% elsif item.collection == 'posts' %}<lastmod>{{ item.date | date_to_xmlschema }}</lastmod>{% endif %}</url>
  {% endif %}{% endfor %}
</urlset>
