---
layout: null
permalink: /feed.xml
sitemap: false
search: false
---
<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en" xml:base="{{ '/' | absolute_url }}">
  <id>{{ '/feed.xml' | absolute_url }}</id>
  <title>{{ site.title | xml_escape }} — Research notebook</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/blog/' | absolute_url }}"/>
  <updated>{{ site.posts.first.last_modified_at | default: site.posts.first.date | date_to_xmlschema }}</updated>
  <author><name>{{ site.author.name | xml_escape }}</name><uri>{{ '/' | absolute_url }}</uri></author>
  {% for post in site.posts limit:20 %}
  <entry>
    <id>{{ post.url | absolute_url }}</id>
    <title>{{ post.title | xml_escape }}</title>
    <link href="{{ post.url | absolute_url }}"/>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
    <summary>{{ post.description | default: post.excerpt | strip_html | normalize_whitespace | xml_escape }}</summary>
    <content type="html">{{ post.content | markdownify | xml_escape }}</content>
  </entry>
  {% endfor %}
</feed>
